# Reglas udev para Dobot Magician en Ubuntu / Debian
# Permite acceso sin sudo y crea el symlink persistente /dev/dobot_magician

SUBSYSTEM=="tty", ATTRS{idVendor}=="10c4", ATTRS{idProduct}=="ea60", MODE="0666", GROUP="dialout", SYMLINK+="dobot_magician"
SUBSYSTEM=="tty", ATTRS{idVendor}=="1a86", ATTRS{idProduct}=="7523", MODE="0666", GROUP="dialout", SYMLINK+="dobot_magician"
