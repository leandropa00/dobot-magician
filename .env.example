# ==============================================================================
# VARIABLES DE ENTORNO - DOBOT MAGICIAN
# ==============================================================================

# Clave de API de Anthropic (requerida para visión artificial y dibujo inteligente)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ==============================================================================
# MODELO DE CLAUDE PARA VISIÓN Y DIBUJO (ANTHROPIC_MODEL)
# ==============================================================================
# Define qué modelo de Anthropic procesará las fotografías y generará las trayectorias
# de dibujo para el Dobot Magician.
#
# MODELOS PERMITIDOS / RECOMENDADOS (con soporte de Visión + Tool Calling):
# ------------------------------------------------------------------------------
# • claude-sonnet-5-20260630   (o claude-sonnet-5 / claude-sonnet-5-latest)
#   - Claude Sonnet 5: razonamiento agéntico de última generación y máxima precisión espacial.
#
# • claude-sonnet-4-5-20250929
#   - Máxima fidelidad en trazos continuos, estilización de contornos y bocetos limpios.
#
# • claude-3-7-sonnet-20250219 (o claude-3-7-sonnet-latest)
#   - Razonamiento visual avanzado y precisión en comprensión espacial de objetos.
#
# • claude-3-5-sonnet-20241022 (o claude-3-5-sonnet-latest)
#   - Claude 3.5 Sonnet v2: referencia de balance entre velocidad, visión y tool calling.
#
# • claude-3-5-haiku-20241022  (o claude-3-5-haiku-latest)
#   - Claude 3.5 Haiku: ultra rápido y económico; ideal para trazos rápidos y mínima latencia.
#
# • claude-3-opus-20240229    (o claude-3-opus-latest)
#   - Claude 3 Opus: máxima profundidad conceptual y matices artísticos complejos.
# ------------------------------------------------------------------------------
ANTHROPIC_MODEL=claude-sonnet-5-20260630
